# Collab.ia — Variables de entorno
# Copia este archivo como .env.local y completa los valores

# Google Gemini API Key
# Obtén una en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Base URL (para llamadas internas)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Prisma / SQLite (no necesita configuración extra en local)
# El archivo de base de datos se crea automáticamente en ./prisma/dev.db
DATABASE_URL="file:./dev.db"
